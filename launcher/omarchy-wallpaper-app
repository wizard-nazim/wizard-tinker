#!/usr/bin/env bash
# Launcher for the Wallpaper Manager local web app.
set -euo pipefail

APP_DIR="$HOME/Projects/omarchy/live-wallpaper-proj"
PID_FILE="$APP_DIR/server.pid"
PORT=5847
URL="http://127.0.0.1:$PORT"

is_running() {
  [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

if ! is_running; then
  cd "$APP_DIR"
  nohup "$APP_DIR/venv/bin/python" "$APP_DIR/app.py" "$PORT" >"$APP_DIR/server.log" 2>&1 &
  disown

  for _ in $(seq 1 50); do
    if curl -s -o /dev/null "$URL"; then
      break
    fi
    sleep 0.1
  done
fi

xdg-open "$URL" >/dev/null 2>&1 &
